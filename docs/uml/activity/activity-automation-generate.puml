@startuml
skinparam shadowing false
skinparam dpi 180
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

title Activity: Automation - Generate Script

|Tester|
start
:Navigate to Test Case Detail > Automation tab;

|Frontend|
:GET /api/ai/settings;

|Backend|
:AIService.getSettings();

|Frontend|
:Check if AI configured (enabled, provider != RULE_ENGINE, apiKeyConfigured, model);
if (AI Configured?) then (no)
  :Show Empty State: "Configure AI in Settings";
  stop
else (yes)
  :Show AI Assistant card (Provider, Model, Status);
  :Click "Generate Script";
  :Select Method: "AI Generator" or "Template Engine";
  if (AI Generator?) then (yes)
    :POST /api/automation/test-cases/{id}/generate-script {method: "AI"};
  else (no)
    :POST /api/automation/test-cases/{id}/generate-script {method: "TEMPLATE"};
  endif
endif

|Backend|
:AutomationService.generateScript(testCaseId, {method});
:loadRunConfig(testCaseId);
:TestCaseRepository.getTestCaseForRun();
:Project config (baseUrl, browser, viewport, auth, etc.);
:Build AuthEngine (disable auto-login if login flow detected);
:Get AI Settings;
:Resolve Provider (AI: from AI settings; Template: RULE_ENGINE);
:Get Generator (AIGenerator or TemplateGenerator);

if (AI Generator?) then (yes)
  :AIGenerator.generate(context);
  :Build Project Context (baseUrl, loginUrl, browser, viewport, timeout, auth);
  :Build Prompt: {projectContext, title, code, framework, steps};
  :Call AI Provider (Gemini/OpenRouter/Ollama/OpenAI/Custom);
  :Receive generated script;
  :Inject BASE_URL & LOGIN_URL constants;
  :Store in automation_scripts table;
else
  :TemplateGenerator.generate(context);
  :Rule Engine converts steps to Playwright code;
  :Store in automation_scripts table;
endif

:Return {script, generatorType, provider, model};

|Frontend|
:Display generated script in Monaco editor;
:Show "Generated by {provider}" badge;
:Enable "Run Test" button;

stop

@enduml