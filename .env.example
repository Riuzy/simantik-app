# Encryption key used to protect project login credentials at rest.
# Provide 64 hex characters (32 bytes) for AES-256-GCM.
ENCRYPTION_KEY=""

# Client
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_STORAGE_URL="http://localhost:3001"