# Prisma / Database
DATABASE_URL="mysql://root:password@localhost:3306/simantik_database"

# Server
PORT=3001
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
