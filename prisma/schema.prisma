generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// User represents a person who uses the SIMANTIK system.
/// Every authenticated user has the same capabilities (no roles).
model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  avatar             String?   @db.VarChar(500)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  projectsCreated Project[]  @relation("ProjectCreator")
  testCasesCreated TestCase[] @relation("TestCaseCreator")

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

/// Supported automation frameworks.
enum Framework {
  PLAYWRIGHT
  SELENIUM
  CYPRESS
}

/// Browser used by the automation engine.
enum Browser {
  CHROMIUM
  FIREFOX
  WEBKIT
}

/// How the automation engine authenticates against the application under test.
enum LoginMethod {
  /// Fill the login form in the browser (most common).
  BROWSER
  /// Call an authentication API endpoint to obtain a session.
  API
}

/// How the automation engine manages the session lifetime.
enum SessionStrategy {
  /// Reuse a single browser context across every step of the execution.
  REUSE_CONTEXT
  /// Start a fresh context for each step (slower, more isolated).
  NEW_SESSION
}

/// Project represents an automation testing project.
/// It is the single source of truth for every setting consumed by the
/// automation engine (browser, environment, authentication, ...).
model Project {
  id          String        @id @default(uuid()) @db.Char(36)
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  framework   Framework     @default(PLAYWRIGHT)

  // ===== Automation =====
  baseUrl        String?  @map("base_url") @db.VarChar(500)
  browser        Browser  @default(CHROMIUM)
  environment    String?  @db.VarChar(100)
  headless       Boolean  @default(true)
  timeout        Int      @default(30000)
  slowMo         Int      @default(0) @map("slow_mo")
  viewportWidth  Int      @default(1280) @map("viewport_width")
  viewportHeight Int      @default(720) @map("viewport_height")
  debugMode      Boolean  @default(false) @map("debug_mode")

  // ===== Authentication =====
  authenticationEnabled Boolean         @default(false) @map("authentication_enabled")
  loginUrl              String?         @map("login_url") @db.VarChar(500)
  loginEmail            String?         @map("login_email") @db.VarChar(255)
  loginPassword         String?         @map("login_password") @db.VarChar(500)
  loginMethod           LoginMethod     @default(BROWSER) @map("login_method")
  sessionStrategy       SessionStrategy @default(REUSE_CONTEXT) @map("session_strategy")

  createdById String  @map("created_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy  User     @relation("ProjectCreator", fields: [createdById], references: [id])
  testCases  TestCase[]
  executions Execution[]

  @@index([code])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("projects")
}

enum TestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseStatus {
  DRAFT
  READY
  ARCHIVED
}

/// Distinguishes manually executed test cases from automation-driven ones.
enum TestCaseType {
  MANUAL
  AUTOMATION
}

/// Last automation result of a test case, surfaced in the test case list.
enum TestCaseLastResult {
  NOT_RUN
  RUNNING
  PASSED
  FAILED
}

/// TestCase represents an automation test case inside a project.
model TestCase {
  id                  String             @id @default(uuid()) @db.Char(36)
  code                String             @unique @db.VarChar(50)
  title               String             @db.VarChar(255)
  description         String?            @db.Text
  module              String?            @db.VarChar(255)
  priority            TestPriority       @default(MEDIUM)
  status              TestCaseStatus     @default(DRAFT)
  type                TestCaseType       @default(MANUAL)
  lastExecutionStatus TestCaseLastResult @default(NOT_RUN) @map("last_execution_status")
  lastExecutedAt      DateTime?          @map("last_executed_at")
  lastExecutionId     String?            @map("last_execution_id") @db.Char(36)
  tags                Json?
  projectId           String             @map("project_id") @db.Char(36)
  createdById         String             @map("created_by_id") @db.Char(36)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("TestCaseCreator", fields: [createdById], references: [id])
  steps       TestStep[]
  executions  Execution[]

  @@index([projectId])
  @@index([createdById])
  @@index([priority])
  @@index([status])
  @@index([type])
  @@index([lastExecutionStatus])
  @@index([deletedAt])
  @@map("test_cases")
}

/// TestStep represents an individual ordered step within a test case.
model TestStep {
  id              String   @id @default(uuid()) @db.Char(36)
  testCaseId      String   @map("test_case_id") @db.Char(36)
  stepNumber      Int      @map("step_number")
    action          String   @db.VarChar(100)
    target          String?  @db.Text
    locatorStrategy String?  @map("locator_strategy") @db.VarChar(50)
    locatorValue    String?  @map("locator_value") @db.Text
    locators        Json?    @map("locators")
    inputValue      String?  @map("input_value") @db.Text
  expectedResult  String?  @map("expected_result") @db.Text
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, stepNumber])
  @@index([testCaseId])
  @@index([deletedAt])
  @@map("test_steps")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  CANCELLED
  SKIPPED
}

/// Execution represents the result of running one test case with Playwright.
model Execution {
  id              String          @id @default(uuid()) @db.Char(36)
  number          String          @unique @db.VarChar(50)
  projectId       String          @map("project_id") @db.Char(36)
  testCaseId      String          @map("test_case_id") @db.Char(36)
  status          ExecutionStatus @default(RUNNING)
  durationMs      Int?            @map("duration_ms")
  startedAt       DateTime?       @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  browser         String?         @db.VarChar(50)
  environment     String?         @db.VarChar(100)
  screenshotPath  String?         @map("screenshot_path") @db.VarChar(500)
  videoPath       String?         @map("video_path") @db.VarChar(500)
  tracePath       String?         @map("trace_path") @db.VarChar(500)
  consoleLog      Json?
  errorMessage    String?         @map("error_message") @db.Text
  generatedScript String?         @map("generated_script") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase       @relation(fields: [testCaseId], references: [id])
  logs     ExecutionLog[]

  @@index([projectId])
  @@index([testCaseId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("executions")
}

/// ExecutionLog records each step outcome during an execution.
model ExecutionLog {
  id          String   @id @default(uuid()) @db.Char(36)
  executionId String   @map("execution_id") @db.Char(36)
  stepNumber  Int?     @map("step_number")
  action      String?  @db.VarChar(100)
  level       String   @default("INFO") @db.VarChar(20)
  message     String   @db.Text
  timestamp   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_logs")
}



/// Setting stores global key-value settings.
model Setting {
  key       String    @id @db.VarChar(100)
  value     Json?
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("settings")
}
