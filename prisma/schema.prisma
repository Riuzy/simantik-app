generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// User represents a person who uses the SIMANTIK system.
/// Every authenticated user has the same capabilities (no roles).
model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  avatar             String?   @db.VarChar(500)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  projectsCreated Project[]  @relation("ProjectCreator")
  testCasesCreated TestCase[] @relation("TestCaseCreator")
  attachments     Attachment[] @relation("AttachmentUploader")

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

/// Supported automation frameworks.
enum Framework {
  PLAYWRIGHT
  SELENIUM
  CYPRESS
}

/// Project represents an automation testing project.
model Project {
  id          String        @id @default(uuid()) @db.Char(36)
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  baseUrl     String?       @map("base_url") @db.VarChar(500)
  framework   Framework     @default(PLAYWRIGHT)
  environment String?       @db.VarChar(100)
  status      ProjectStatus @default(ACTIVE)
  createdById String        @map("created_by_id") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  createdBy       User              @relation("ProjectCreator", fields: [createdById], references: [id])
  testCases       TestCase[]
  automationConfig AutomationConfig?
  executions      Execution[]

  @@index([code])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("projects")
}

/// Automation configuration for a project.
model AutomationConfig {
  id             String    @id @default(uuid()) @db.Char(36)
  projectId      String    @unique @map("project_id") @db.Char(36)
  framework      Framework @default(PLAYWRIGHT)
  browser        Browser   @default(CHROMIUM)
  baseUrl        String?   @map("base_url") @db.VarChar(500)
  headless       Boolean   @default(true)
  viewportWidth  Int       @default(1280) @map("viewport_width")
  viewportHeight Int       @default(720) @map("viewport_height")
  timeout        Int       @default(30000)
  retry          Int       @default(0)
  parallel       Int       @default(1)
  slowMotion     Int       @default(0) @map("slow_motion")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("automation_configs")
}

enum Browser {
  CHROMIUM
  FIREFOX
  WEBKIT
}

enum TestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseStatus {
  DRAFT
  READY
  ARCHIVED
}

/// TestCase represents an automation test case inside a project.
model TestCase {
  id          String         @id @default(uuid()) @db.Char(36)
  code        String         @unique @db.VarChar(50)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  module      String?        @db.VarChar(255)
  priority    TestPriority   @default(MEDIUM)
  status      TestCaseStatus @default(DRAFT)
  tags        Json?
  projectId   String         @map("project_id") @db.Char(36)
  createdById String         @map("created_by_id") @db.Char(36)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("TestCaseCreator", fields: [createdById], references: [id])
  steps       TestStep[]
  executions  Execution[]
  attachments Attachment[]

  @@index([projectId])
  @@index([createdById])
  @@index([priority])
  @@index([status])
  @@index([deletedAt])
  @@map("test_cases")
}

/// TestStep represents an individual ordered step within a test case.
model TestStep {
  id              String   @id @default(uuid()) @db.Char(36)
  testCaseId      String   @map("test_case_id") @db.Char(36)
  stepNumber      Int      @map("step_number")
  action          String   @db.VarChar(100)
  target          String?  @db.Text
  locatorStrategy String?  @map("locator_strategy") @db.VarChar(50)
  locatorValue    String?  @map("locator_value") @db.Text
  inputValue      String?  @map("input_value") @db.Text
  expectedResult  String?  @map("expected_result") @db.Text
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, stepNumber])
  @@index([testCaseId])
  @@index([deletedAt])
  @@map("test_steps")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  CANCELLED
  SKIPPED
}

/// Execution represents the result of running one test case with Playwright.
model Execution {
  id              String          @id @default(uuid()) @db.Char(36)
  number          String          @unique @db.VarChar(50)
  projectId       String          @map("project_id") @db.Char(36)
  testCaseId      String          @map("test_case_id") @db.Char(36)
  status          ExecutionStatus @default(RUNNING)
  durationMs      Int?            @map("duration_ms")
  startedAt       DateTime?       @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  browser         String?         @db.VarChar(50)
  environment     String?         @db.VarChar(100)
  screenshotPath  String?         @map("screenshot_path") @db.VarChar(500)
  videoPath       String?         @map("video_path") @db.VarChar(500)
  tracePath       String?         @map("trace_path") @db.VarChar(500)
  consoleLog      Json?
  errorMessage    String?         @map("error_message") @db.Text
  generatedScript String?         @map("generated_script") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase       @relation(fields: [testCaseId], references: [id])
  logs     ExecutionLog[]

  @@index([projectId])
  @@index([testCaseId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("executions")
}

/// ExecutionLog records each step outcome during an execution.
model ExecutionLog {
  id          String   @id @default(uuid()) @db.Char(36)
  executionId String   @map("execution_id") @db.Char(36)
  stepNumber  Int?     @map("step_number")
  action      String?  @db.VarChar(100)
  level       String   @default("INFO") @db.VarChar(20)
  message     String   @db.Text
  timestamp   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("execution_logs")
}

/// Attachment stores files attached to a test case.
model Attachment {
  id           String   @id @default(uuid()) @db.Char(36)
  testCaseId   String   @map("test_case_id") @db.Char(36)
  uploadedById String   @map("uploaded_by_id") @db.Char(36)
  fileName     String   @map("file_name") @db.VarChar(255)
  filePath     String   @map("file_path") @db.VarChar(500)
  fileType     String   @map("file_type") @db.VarChar(100)
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([testCaseId])
  @@index([uploadedById])
  @@map("attachments")
}

/// Setting stores global key-value settings.
model Setting {
  key       String    @id @db.VarChar(100)
  value     Json?
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("settings")
}
